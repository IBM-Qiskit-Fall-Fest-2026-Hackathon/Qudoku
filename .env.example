# Optional: IBM Quantum Runtime API token for live QPU execution.
# Leave empty to run all circuits locally on Qiskit AerSimulator (ideal + Heron/Eagle noise models).
QISKIT_IBM_TOKEN=

# Optional: Frontend Vite dev proxy target (defaults to http://127.0.0.1:8000 locally, http://backend:8000 in Docker)
VITE_API_TARGET=http://127.0.0.1:8000
